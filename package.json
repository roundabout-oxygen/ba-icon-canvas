{
  "name": "bluearchive-icon-canvas",
  "version": "1.0.7",
  "description": "Blue Archive Character Icon Canvas Editor",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "tsc -p tsconfig.electron.json",
    "dist": "npm run build && npm run electron:build && electron-builder --win portable"
  },
  "keywords": [
    "bluearchive",
    "tierlist",
    "canvas",
    "editor"
  ],
  "author": "roundabout-oxygen",
  "license": "MIT",
  "dependencies": {
    "html-to-image": "^1.11.11",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.roundaboutoxygen.baiconcanvas",
    "productName": "BlueArchiveIconCanvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "artifactName": "BlueArchiveIconCanvas.${ext}"
    }
  }
}
